# Deployed server-side as Supabase Edge Function secrets, not bundled into
# the extension. Set with: supabase secrets set --env-file .env.local
# (only CLAUDE_API_KEY / BRAVE_API_KEY — strip the other vars first)
CLAUDE_API_KEY=your_anthropic_key_here
BRAVE_API_KEY=your_brave_search_key_here

VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Publishable key from Supabase → Settings → API. Safe to embed
# client-side; build.js injects it into the extension bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
